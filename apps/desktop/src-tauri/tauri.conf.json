{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZeroG Pulse",
  "version": "0.1.0",
  "identifier": "org.zerogpulse.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://127.0.0.1:5180",
    "beforeDevCommand": "npm --prefix ../web run dev -- --host 127.0.0.1 --port 5180",
    "beforeBuildCommand": "npm --prefix ../web run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZeroG Pulse",
        "width": 1440,
        "height": 900,
        "minWidth": 390,
        "minHeight": 600,
        "backgroundColor": "#000000"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
