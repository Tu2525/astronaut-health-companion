# Copy to /etc/ahc/api.env on the VM (chmod 600). Never commit the real file.
# These are the names ahc-api must read (ENGINE: please match them or tell DEVOPS).
AHC_BIND=127.0.0.1:8080
AHC_DATA_DIR=/var/lib/ahc
AHC_GROUND_USER=ground
AHC_GROUND_PASSWORD=change-me
# Comma-separated origins allowed by CORS, e.g. the pages.dev site.
AHC_CORS_ORIGINS=https://ahc.pages.dev
